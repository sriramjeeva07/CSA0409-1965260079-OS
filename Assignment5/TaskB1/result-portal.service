[Unit]
Description=University Result Portal sample application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/result-portal
EnvironmentFile=-/etc/result-portal.env
ExecStart=/opt/result-portal/venv/bin/gunicorn --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/result-portal

[Install]
WantedBy=multi-user.target